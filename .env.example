# Copy to .env.local for local work. The same names are used in Vercel.

# The spreadsheet IDs, each from its URL:
# https://docs.google.com/spreadsheets/d/<THIS PART>/edit
# The master workbook has the Projects, Overheads and Targets tabs.
GOOGLE_SHEET_ID=
# The pipeline workbook has the Pipeline and Probability tabs.
GOOGLE_PIPELINE_SHEET_ID=

# The whole service-account JSON key, base64 encoded so it fits on one line.
# Generate it with:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
# Raw JSON is also accepted, but a PEM private key is multi-line and awkward
# to paste, so base64 is the easier route.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Sign in with Google. Create an OAuth client (Web application) in Google Cloud
# with the redirect URL  <site address>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who may sign in. People, their roles and expiry dates are kept in the Access
# tab of the master workbook. These two name the administrators, who have full
# access whatever the tab says: single addresses, and optionally whole
# domains, comma separated.
ALLOWED_EMAILS=
ALLOWED_DOMAINS=

# The site's public address, e.g. https://finance.btg.studio. Required in
# production; leave empty for local work.
APP_URL=

# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# Seconds the sheet may be served from cache before being read again.
SHEET_REVALIDATE_SECONDS=60

# The chat: Claude, through the Anthropic Messages API. Without a key the chat
# is switched off and the rest of the dashboard works as usual.
ANTHROPIC_API_KEY=
# Optional. The model to use. Defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=
# Optional. Questions one person may ask per hour. Defaults to 30.
CHAT_HOURLY_LIMIT=30
